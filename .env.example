# ==============================================================================
# ClipForge - Environment Configuration (.env)
# Self-Hosted Personal Edition (CPU-Optimized for 8 vCPUs / 16 GB RAM)
# ==============================================================================

# --- Database & Storage ---
# Path to SQLite database file (persists settings, OAuth accounts, and publish logs)
DB_PATH=/app/data/clipforge.db

# --- Retention & Deletion Policy ---
# Default is 0: videos are kept indefinitely unless deleted manually from the Library.
# When deleted manually, the project is removed from listings immediately and purged from disk after 24 hours.
# Set to a positive number of seconds (e.g., 86400 for 24h) if you want automatic time-based purging.
JOB_RETENTION_SECONDS=0

# --- AI Provider Configuration (Seeds SQLite on first run) ---
# Active provider: "openai" (OpenAI-compatible endpoints) or "gemini"
LLM_PROVIDER=openai

# OpenAI-Compatible endpoint (OneByt, Groq, Ollama, OpenRouter, vLLM, DeepSeek, OpenAI)
LLM_BASE_URL=https://api.onebyt.live/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# --- Public Endpoints & Reverse Proxy (Dokploy / Single Domain Setup) ---
# For Dokploy single-domain deployment, both point to your single domain.
# All /api/ and /videos/ routes are handled by the integrated Nginx reverse proxy.
# Leave blank or set to your domain:
PUBLIC_API_URL=https://shorts.yourdomain.com
PUBLIC_FRONTEND_URL=https://shorts.yourdomain.com

# Trusted reverse proxy IPs for X-Forwarded-For headers (use * if behind Docker proxy)
FORWARDED_ALLOW_IPS=*

# --- Social Publishing (Optional / Can also be configured in UI Settings) ---
# Alternative 3rd-party multi-platform publisher key
UPLOAD_POST_API_KEY=

# --- YouTube Downloader (yt-dlp) ---
# Optional: Netscape-format cookies to bypass YouTube bot detection on data centers
# YOUTUBE_COOKIES=

# --- CPU Performance Tuning (Calibrated for 8 vCPUs / 16 GB RAM) ---
# Parallel clip cutting/rendering workers (3 is optimal for 8 vCPUs)
CLIP_WORKERS=3

# Face-tracking detection stride (6 = ~5 detections/sec at 30fps with smooth camera interpolation)
DETECT_STRIDE=6

# Scene cut detection engine: "pyscenedetect" (fast C++ OpenCV) | "transnetv2" (PyTorch neural net)
SCENE_ENGINE=pyscenedetect

# Video encoder: "x264" (CPU) | "nvenc" (GPU)
FFMPEG_ENCODER=x264

# FFmpeg libx264 CPU encoding threads per process
FFMPEG_THREADS=3

# Remotion Renderer concurrency & frame extraction format
REMOTION_CONCURRENCY=2
REMOTION_IMAGE_FORMAT=jpeg

# Math library thread allocation per worker to prevent CPU thread contention
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2

# --- Speech-to-Text (Whisper) ---
# Whisper model size: "small" (recommended multi-lingual) | "base" (faster on CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Beam size: 1 for CPU (greedy, 4x-5x faster decoding without quality loss), 5 for GPU
WHISPER_BEAM_SIZE=1
# CPU threads allocated to CTranslate2 Whisper decoding
WHISPER_THREADS=4
